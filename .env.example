# Database
DATABASE_URL="postgresql://waani_user:waani_password@localhost:5432/waani?schema=public"

# API Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:8000

# Security
JWT_SECRET=super-secret-waani-jwt-token-key-change-in-production-min32chars
